# stub runs with no key. openai-compatible is wired.
# OpenRouter uses LLM_MODEL=google/gemini-2.5-flash-lite and LLM_BASE_URL=https://openrouter.ai/api/v1.
# The research command reads .env. A variable already set in the shell wins.
LLM_PROVIDER=stub
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
COMPOSIO_API_KEY=
COMPOSIO_SEARCH_TOOL_SLUG=
COMPOSIO_SCRAPE_TOOL_SLUG=
